				["\"I just don't need it.\"", &"dont_need"],
			]],
		"empathize": [[
				"\"No problem at all. Can I ask why?\"",
				"\"That's okay. Mind if I ask why?\"",
			], ["\"Just not sure it's worth it.\"", "\"I just don't see the point.\""]],
	},
]

func _init() -> void:
	DirAccess.make_dir_recursive_absolute(DIR)

	var built: Array[DialogueLine] = []
	for row in LINES:
		built.append(_line(row[0], row[1], row[2], row[3], row[4]))
	for k in range(EXCHANGES.size()):
		built.append_array(_exchange_lines(EXCHANGES[k], k))
	for o in OBJECTIONS:
		built.append_array(_objection_lines(o))

	var pool := DialoguePool.new()
	pool.design_rule = DESIGN_RULE
	pool.known_tags.assign(KNOWN_TAGS)
	pool.known_objections.assign(KNOWN_OBJECTIONS)
	pool.lines = built
	var err := ResourceSaver.save(pool, "%s/dialogue_pool.tres" % DIR)
	if err != OK:
		push_error("failed to save dialogue_pool.tres: %d" % err)
		quit(1)
		return

	print("built %d lines across %d tags and %d objections"
		% [built.size(), KNOWN_TAGS.size(), KNOWN_OBJECTIONS.size()])
	quit(0)


func _line(tags: Array, text: String, archetypes: Array = [], products: Array = [],
		bands: Array = [], objections: Array = [],
		becomes: StringName = &"") -> DialogueLine:
	var l := DialogueLine.new()
	l.tags.assign(tags)
	l.text = text
	l.archetype_ids.assign(archetypes)
	l.product_ids.assign(products)
	l.appeal_bands.assign(bands)
	l.objection_ids.assign(objections)
	l.becomes = becomes
	return l


## One OBJECTIONS entry, as lines: its raises, each opening it, then each
## technique's lines for it and their answers to those.
func _objection_lines(o: Dictionary) -> Array[DialogueLine]:
	var id: StringName = o["id"]
	var out: Array[DialogueLine] = []
	if o.has("raise"):
		var tag: StringName = o["raise"][0]
		for r in o["raise"][1]:
			out.append(_line([tag], r[0], r[1] if r.size() > 1 else [],
				r[2] if r.size() > 2 else [], [], [], id))
	for technique in TECHNIQUES:
		if not o.has(technique):
			continue
		var said: Array = o[technique]
		var yours: StringName = TECHNIQUES[technique][0]
		var theirs: StringName = TECHNIQUES[technique][1]
		for text in said[0]:
			out.append(_line([yours], text, [], [], [], [id]))
		if said.size() < 2 or theirs == &"":
			continue
		for answer in said[1]:
			if answer is Array:
				out.append(_line([theirs], answer[0], [], [], [], [id], answer[1]))
			else:
				out.append(_line([theirs], answer, [], [], [], [id]))
	return out

## One EXCHANGES row, as lines: yours, keyed, and the replies written for it.
func _exchange_lines(x: Array, index: int) -> Array[DialogueLine]:
	var key := StringName("%s_%d" % [x[0], index])
	var yours := _line([x[0]], x[2], x[3])
	yours.key = key
	var out: Array[DialogueLine] = [yours]
	for r in x[4]:
		var reply := _line([x[1]], r[0], r[1] if r.size() > 1 else [])
		reply.replies_to.assign([key])
		out.append(reply)
	return out
