[gd_resource type="Resource" script_class="Demand" format=3]

[ext_resource type="Script" path="res://scripts/model/effects/effect.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/model/effects/drop_offer.gd" id="2_drp"]
[ext_resource type="Script" path="res://scripts/model/demands/play_concession.gd" id="3_rsv"]
[ext_resource type="Script" path="res://scripts/model/data/demand.gd" id="4_dmd"]

[sub_resource type="Resource" id="Sub_drop"]
script = ExtResource("2_drp")

[sub_resource type="Resource" id="Sub_rsv"]
script = ExtResource("3_rsv")

[resource]
script = ExtResource("4_dmd")
id = &"better_quote"
display_name = "Got a better quote across town"
telegraph = "BETTER QUOTE"
dialogue = "\"The place on Dundas does this for less.\""
ticks = 4
resolve = SubResource("Sub_rsv")
effects = Array[ExtResource("1_eff")]([SubResource("Sub_drop")])
