[ext_resource type="Script" path="res://scripts/model/effects/walk_out.gd" id="2_out"]
[ext_resource type="Script" path="res://scripts/model/demands/make_an_offer.gd" id="3_rsv"]
[ext_resource type="Script" path="res://scripts/model/data/demand.gd" id="4_dmd"]

[sub_resource type="Resource" id="Sub_out"]
