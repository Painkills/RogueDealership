[resource]
script = ExtResource("5_pool")
design_rule = "Three tiers, always exactly three, and every one of them ends with a free card in the shop: morning (the easiest slot), midday (a floor-difficulty knob - shorter patience - paid for with cards put up for sale), and night (the hardest slot - fewer, tougher customers - paid for with upgrades). Each tier has a difficulty target that climbs over the run (difficulty_start, difficulty_per_day), and every shift dealt in its slot is built to it: a lineup of the tier's `customers`, picked from whoever the week allows until their points add up (see ShiftGenerator). A new tier is a fourth .tres and one more line in profiles below; it is never a branch in Shift.gd or Shop.gd keyed on an id string - every difference a tier makes has to be one of ShiftProfile's own fields. Premade shifts are ShiftProfiles too, dealt onto the calendar by the categories below (see Week): a category says which days and which tier's slot its shifts may take, and whether they are bosses - one takes the place of one of the day's shifts, at random. A premade shift that is not a boss only comes up where its difficulty fits the slot, at most once a week, and is paid like the slot it took. Each shift's own chance is how likely it is to come up instead of the regular one there. Quota is standard for the day (it climbs 8% a day whatever the slot): a shift asks for more of it only by spending difficulty points on a quota step, one of the complicators below marked for regular shifts. The rest of the complicators are the twists a premade shift that scales can be dealt with, to make a harder slot's target."
profiles = Array[ExtResource("1_prf")]([ExtResource("2_morn"), ExtResource("3_mid"), ExtResource("4_night")])
categories = Array[ExtResource("1_1vyqb")]([ExtResource("2_v286r"), ExtResource("3_boss"), ExtResource("6_boss_fri"), ExtResource("7_final"), ExtResource("8_specific")])
complicators = Array[ExtResource("9_comp")]([ExtResource("10_crowd"), ExtResource("11_late"), ExtResource("12_fuse"), ExtResource("13_desk"), ExtResource("14_once"), ExtResource("15_q10"), ExtResource("16_q20"), ExtResource("17_q30")])
