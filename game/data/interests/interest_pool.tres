[resource]
script = ExtResource("15_wkyj5")
design_rule = "Exactly 3 categories x 3 interests = 9, and every interest has exactly one product answering it. The count is load-bearing: appeal = appeal_step x (interest_count - rank), so a tenth interest silently reflates every appeal number in the game. Categories exist so a read can hand you PARTIAL information - \"they are a Vehicle person\" is worth a tick precisely because it narrows nine to three rather than to one."
categories = Array[ExtResource("1_6vg3t")]([ExtResource("2_85tif"), ExtResource("3_vtrah"), ExtResource("4_lh4yw")])
interests = Array[ExtResource("5_wk41v")]([ExtResource("6_lclw5"), ExtResource("7_akuu6"), ExtResource("8_tjgw4"), ExtResource("9_e0nq2"), ExtResource("10_nsopj"), ExtResource("11_slvcg"), ExtResource("12_cs1nu"), ExtResource("13_rj5b0"), ExtResource("14_ob485")])
