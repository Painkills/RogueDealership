[resource]
script = ExtResource("20_bnf0e")
design_rule = "At least one product per interest - nine interests, no gaps, and as many as the catalog wants beyond that: in a menu run each interest is one slot, so a second product for it is a choice to swap, never a pile. The STARTER six are two per category, which is load-bearing twice over: a category read is always actionable, and the Karen's demanded category is always servable. Margins are a ladder deliberately uncorrelated with how often an interest is ranked highly, so their number one might be the $600 concierge plan while the $1,600 service contract sits seventh. Ticks are the scarce currency, so the big concession is tick-cheap and margin-expensive and the small one is the reverse; a card better than another on both axes is a bug. No support card may move appeal by a full appeal_step for free, or it becomes a substitute for reading the customer and diagnosis stops paying. Rarity is a fourth axis: Basic is the starter deck (or a future non-starter card meant to feel just as ordinary), Economy runs roughly $700-1000, Value $1000-1300, and Preferred $1300-2000+ - each step up should buy a stronger or more flexible effect, not just a bigger number bolted onto the same one. For products, rarity is value per tick: margin plus what the effects are worth (a point of patience $100, of appeal $200, of Line dropped $200), over the ticks to place it - Basic 650-950, Economy 1000-1100, Value 1150-1250, Preferred 1300-1500, none overlapping, and a 3-tick product, a big commitment, lands in the upper half of its band while a tier's shorter ones stay in the lower half (tools/product_values.gd). A product's own appeal may reach 4, a full appeal step, and no more; and a rarer product may beat a commoner one for its interest, but not one of its own rarity."
cards = Array[ExtResource("1_gunhf")]([ExtResource("2_5hkca"), ExtResource("3_3ka7l"), ExtResource("4_rifbx"), ExtResource("5_ajodq"), ExtResource("6_v0jhj"), ExtResource("7_x6epx"), ExtResource("8_ba7dx"), ExtResource("9_6jq6c"), ExtResource("10_offko"), ExtResource("11_lu1nf"), ExtResource("12_5us2d"), ExtResource("13_y27ja"), ExtResource("14_t68k7"), ExtResource("15_kaqos"), ExtResource("16_veflx"), ExtResource("17_ej5nb"), ExtResource("18_ipwxn"), ExtResource("19_y836a"), ExtResource("20_rifbx"), ExtResource("20_5hkca"), ExtResource("22_ajodq"), ExtResource("23_ajodq"), ExtResource("24_v0jhj"), ExtResource("25_x6epx"), ExtResource("26_ba7dx"), ExtResource("27_6jq6c"), ExtResource("28_emp"), ExtResource("29_bump"), ExtResource("30_good"), ExtResource("31_fee"), ExtResource("32_cof"), ExtResource("33_think"), ExtResource("34_keep"), ExtResource("35_mind"), ExtResource("36_insist"), ExtResource("37_risky"), ExtResource("38_meet"), ExtResource("39_everyone"), ExtResource("40_p_powertrain"), ExtResource("41_p_esc"), ExtResource("42_p_gps_recovery"), ExtResource("43_p_total_theft"), ExtResource("44_p_trail_ready"), ExtResource("45_p_tow_hitch"), ExtResource("46_p_rate_buydown"), ExtResource("47_p_extended_term"), ExtResource("48_p_ltv_shield"), ExtResource("49_p_paint_fabric"), ExtResource("50_p_certified_resale"), ExtResource("51_p_credit_life"), ExtResource("52_p_prepaid_maintenance"), ExtResource("53_p_valet_club"), ExtResource("54_p_dent_ding"), ExtResource("55_p_signature_detail")])
