[ext_resource type="Script" path="res://scripts/model/data/card_pool.gd" id="20_bnf0e"]

[resource]
script = ExtResource("20_bnf0e")
design_rule = "One product per interest, exactly - nine interests, nine products, no gaps and no doubles. The STARTER six are two per category, which is load-bearing twice over: a category read is always actionable, and the Karen's demanded category is always servable. Margins are a ladder deliberately uncorrelated with how often an interest is ranked highly, so their number one might be the $600 concierge plan while the $1,600 service contract sits seventh. Ticks are the scarce currency, so the big concession is tick-cheap and margin-expensive and the small one is the reverse; a card better than another on both axes is a bug. No support card may move appeal by a full appeal_step for free, or it becomes a substitute for reading the customer and diagnosis stops paying."
cards = Array[ExtResource("1_gunhf")]([ExtResource("2_5hkca"), ExtResource("3_3ka7l"), ExtResource("4_rifbx"), ExtResource("5_ajodq"), ExtResource("6_v0jhj"), ExtResource("7_x6epx"), ExtResource("8_ba7dx"), ExtResource("9_6jq6c"), ExtResource("10_offko"), ExtResource("11_lu1nf"), ExtResource("12_5us2d"), ExtResource("13_y27ja"), ExtResource("14_t68k7"), ExtResource("15_kaqos"), ExtResource("16_veflx"), ExtResource("17_ej5nb"), ExtResource("18_ipwxn"), ExtResource("19_y836a")])
