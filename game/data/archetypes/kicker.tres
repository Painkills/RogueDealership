[sub_resource type="Resource" id="Sub_be_back"]
script = ExtResource("1_apes3")
id = &"be_back"
display_name = "Gets up to leave"
tell = "the first time his patience drops to 3 he gets up to go. Ask him for the business within 2 ticks and he sits back down with +4 patience, or he WALKS"
