[gd_resource type="Resource" script_class="CustomerArchetype" format=3]

[ext_resource type="Script" path="res://scripts/model/data/customer_action.gd" id="1_syiqa"]
[ext_resource type="Script" path="res://scripts/model/effects/effect.gd" id="2_q8rar"]
[ext_resource type="Script" path="res://scripts/model/effects/raise_demand.gd" id="3_oj240"]
[ext_resource type="Resource" path="res://data/demands/thinking.tres" id="10_dmd"]
[ext_resource type="Script" path="res://scripts/model/triggers/every.gd" id="4_m1acs"]
[ext_resource type="Script" path="res://scripts/model/data/interest.gd" id="5_kagv6"]
[ext_resource type="Resource" path="res://data/interests/status.tres" id="6_xystn"]
[ext_resource type="Script" path="res://scripts/model/data/customer_archetype.gd" id="7_7gpfm"]
[ext_resource type="Resource" path="res://data/interests/stability.tres" id="8_i77n1"]
[ext_resource type="Resource" path="res://data/interests/reliability.tres" id="9_d0jgs"]

[sub_resource type="Resource" id="Resource_r4edv"]
script = ExtResource("3_oj240")
demand = ExtResource("10_dmd")

[sub_resource type="Resource" id="Resource_5stk6"]
script = ExtResource("4_m1acs")
ticks = 6

[sub_resource type="Resource" id="Resource_idwwe"]
script = ExtResource("1_syiqa")
id = &"thinking"
display_name = "Needs a minute to talk it over"
tell = "every 6 ticks they need a minute. Go and work somebody else for 3 ticks and they come back easier; keep at them and it costs 5 patience"
dialogue = "\"Could we have a moment?\""
trigger = SubResource("Resource_5stk6")
effects = Array[ExtResource("2_q8rar")]([SubResource("Resource_r4edv")])

[resource]
script = ExtResource("7_7gpfm")
id = &"family"
display_name = "Family First"
pattern = "Give them room. They will not be rushed, and the tick you spend hovering over them is the one that loses them."
tell = "there are two car seats in the trade-in"
line_per_sale = 0
min_shift = 2
top_interests = Array[ExtResource("5_kagv6")]([ExtResource("8_i77n1"), ExtResource("9_d0jgs")])
bottom_interests = Array[ExtResource("5_kagv6")]([ExtResource("6_xystn")])
actions = Array[ExtResource("1_syiqa")]([SubResource("Resource_idwwe")])
