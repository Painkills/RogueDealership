[gd_resource type="Resource" script_class="CustomerArchetype" format=3]

[ext_resource type="Script" path="res://scripts/model/data/customer_archetype.gd" id="1_arch"]
[ext_resource type="Script" path="res://scripts/model/data/demand.gd" id="2_dmd"]
[ext_resource type="Script" path="res://scripts/model/data/timed_move.gd" id="3_tm"]
[ext_resource type="Resource" path="res://data/demands/whale_getting_impatient.tres" id="4_imp"]
[ext_resource type="Resource" path="res://data/demands/whale_raise_the_stakes.tres" id="5_stk"]
[ext_resource type="Resource" path="res://data/demands/whale_off_my_desk.tres" id="6_desk"]

[sub_resource type="Resource" id="Timed_desk"]
script = ExtResource("3_tm")
every_ticks = 9
move = ExtResource("6_desk")

[resource]
script = ExtResource("1_arch")
hard = true
weight = 0.0
difficulty = 0
id = &"whale"
display_name = "The Whale"
pattern = "A fight, not a sale: keep their patience up, take the truck off the desk, and sell their budget down to nothing."
tell = "a black card already on the desk, and a list of conditions"
line = 26
patience = 20
line_per_sale = 2
combo_step = 0.25
arrival_patience_share = 1.0
budget_share = 1.0
patience_is_shield = true
moves = Array[ExtResource("2_dmd")]([ExtResource("4_imp"), ExtResource("5_stk")])
timed_moves = Array[ExtResource("3_tm")]([SubResource("Timed_desk")])
move_gap_ticks = 0
sold_products_leave_deck = true
escalate_damage = 1
escalate_fuse = 0
min_move_fuse = 1
