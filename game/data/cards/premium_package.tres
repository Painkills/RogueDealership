[gd_resource type="Resource" script_class="SupportCardDef" format=3]

[ext_resource type="Script" path="res://scripts/model/effects/effect.gd" id="1_effect"]
[ext_resource type="Script" path="res://scripts/model/data/support_card_def.gd" id="2_def"]
[ext_resource type="Script" path="res://scripts/model/effects/scale_by_sales.gd" id="3_scale"]
[ext_resource type="Script" path="res://scripts/model/effects/margin_percent.gd" id="4_percent"]

[sub_resource type="Resource" id="Inner_base_0"]
script = ExtResource("4_percent")
