[resource]
script = ExtResource("2_xfm46")
design_rule = "One library, divided by TAG, not by file. A line's tags say which pool it belongs to and are the only required match; archetype_ids, product_ids and appeal_bands are optional narrowings, and an empty one means any. Narrowing is additive and exclusive: a line naming karen is unavailable to everybody else, never merely less likely. Every tag must keep at least one line with NO narrowings at all - that is the fallback that stops a pool going silent, and the suite enforces it. Specific lines are WEIGHTED over generic ones, never substituted for them: one karen line must not make ten generic ones unreachable, or every karen says the same sentence for the rest of the run. The player_* tags are YOUR lines, asked for by a card's player_dialogue_tags; on those, an archetype narrowing means who you are talking to. GENERATED by tools/build_dialogue.gd - edit the rows there, not this file."
known_tags = Array[StringName]([&"appeal", &"patience", &"concession", &"pressure", &"padding", &"demand_thinking", &"demand_restless", &"demand_manager", &"demand_show_me", &"demand_better_quote", &"relief", &"ignored", &"accepted", &"impatient", &"player_pitch", &"player_smalltalk", &"player_explain", &"player_discount", &"player_bundle", &"player_fearmonger", &"player_coffee", &"player_hardclose", &"player_pad", &"player_readroom", &"player_checknotes", &"player_comp", &"player_justthething", &"player_rightword", &"player_smile", &"player_jazz"])
