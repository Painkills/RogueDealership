[resource]
script = ExtResource("2_xfm46")
design_rule = "One library, divided by TAG, not by file. A line's tags say which pool it belongs to and are the only required match; archetype_ids, product_ids, appeal_bands and objection_ids are optional narrowings, and an empty one means any. Narrowing is additive and exclusive: a line naming karen is unavailable to everybody else, never merely less likely. Every tag must keep at least one line with NO narrowings at all - that is the fallback that stops a pool going silent, and the suite enforces it. Specific lines are WEIGHTED over generic ones, never substituted for them: one karen line must not make ten generic ones unreachable, or every karen says the same sentence for the rest of the run. The one exception is an open objection: where lines answer it, only they are drawn, because the word track written for it IS the answer. A line's `becomes` opens or moves the customer's objection when it is said. The player_* tags are YOUR lines, asked for by a card's player_dialogue_tags; on those, an archetype narrowing means who you are talking to. GENERATED by tools/build_dialogue.gd - edit the rows there, not this file."
known_tags = Array[StringName]([&"appeal", &"patience", &"concession", &"pressure", &"padding", &"demand_thinking", &"demand_restless", &"demand_manager", &"demand_show_me", &"demand_better_quote", &"relief", &"ignored", &"accepted", &"impatient", &"objection", &"objection_walkaway", &"objection_walkaway_gap", &"interested", &"reply_empathize", &"reply_clarify", &"reply_relate", &"reply_value", &"reply_budget", &"reply_listen", &"player_pitch", &"player_smalltalk", &"player_empathize", &"player_budget", &"player_value", &"player_fearmonger", &"player_relate", &"player_clarify", &"player_pad", &"player_listen", &"player_guide", &"player_comp", &"player_justthething", &"player_rightword", &"player_smile", &"player_jazz", &"player_close"])
known_objections = Array[StringName]([&"walkaway_too_expensive", &"walkaway_no_thanks", &"walkaway_dont_need", &"walkaway_savings", &"walkaway_line_of_credit", &"walkaway_work_coverage", &"walkaway_lots_of_insurance", &"walkaway_wont_qualify", &"walkaway_buy_outright", &"walkaway_gap_too_expensive", &"walkaway_gap_insured", &"walkaway_gap_dont_need", &"walkaway_gap_no_thanks", &"too_expensive", &"dont_need", &"no_thanks"])
